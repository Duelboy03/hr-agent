{
  "name": "hr-agent",
  "private": true,
  "version": "1.0.0",
  "description": "A tool-using HR assistant agent: it looks things up and takes actions, but asks a human before changing anything.",
  "license": "MIT",
  "author": "Zaid Nayeem",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @hr-agent/web",
    "build": "npm run build -w @hr-agent/web",
    "typecheck": "tsc -p packages/agent && tsc -p apps/web",
    "lint": "oxlint packages/agent/src apps/web/src e2e",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test e2e/app.spec.ts",
    "screenshots": "SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
